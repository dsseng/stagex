FROM scratch AS build
ARG VERSION
COPY --from=stagex/core-perl . /
COPY --from=stagex/core-m4 . /
COPY --from=stagex/core-busybox . /
COPY --from=stagex/core-musl . /
COPY --from=stagex/core-gcc . /
COPY --from=stagex/core-binutils . /
COPY --from=stagex/core-make . /
COPY --from=fetch . .
RUN tar -xf groff-${VERSION}.tar.gz
WORKDIR /groff-${VERSION}
ENV SOURCE_DATE_EPOCH=1
ENV CFLAGS=" \
	-mtune=generic -march=x86-64 \
	-g -Os -std=c99 -ffreestanding \
	-fexcess-precision=standard -frounding-math \
	-fno-strict-aliasing -fno-unwind-tables \
	-fno-asynchronous-unwind-tables -ffunction-sections \ 
	-fdata-sections -fPIC -fno-stack-protector"
RUN --network=none <<-EOF
	set -eux
	./configure \
		--prefix=/usr \
		--without-x \
		--disable-rpath
	make -j "$(nproc)"
	make DESTDIR=/rootfs install
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
